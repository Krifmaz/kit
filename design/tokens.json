{
  "$comment": "The kit's look, defined once. design/gen (kit-tokens) turns it into CSS variables, a Compose theme, an Iced theme and Flutter ThemeData. The default theme is `encore` (charcoal and cream); every app can offer the same theme picker.",
  "version": 1,
  "status": {
    "ok": "#22c55e",
    "warn": "#f59e0b",
    "err": "#ef4444",
    "info": "#38bdf8"
  },
  "themes": [
    {
      "id": "encore",
      "name": "Encore",
      "css_selector": ":root",
      "note": "the default: charcoal and cream",
      "dark": true,
      "colors": {
        "bg": "#161617",
        "bg-2": "#1c1c1e",
        "panel": "#222224",
        "panel-2": "#2a2a2d",
        "border": "#353538",
        "text": "#f0ead6",
        "muted": "#aaa493",
        "faint": "#77725f",
        "accent": "#f0ead6",
        "accent-2": "#d6c49a",
        "on-accent": "#16161f"
      },
      "shadow": "0 10px 30px rgba(0, 0, 0, .35)"
    },
    {
      "id": "dark",
      "name": "Dark",
      "css_selector": ":root[data-theme=\"dark\"]",
      "note": "blue-black",
      "dark": true,
      "colors": {
        "bg": "#0b0b12",
        "bg-2": "#12121c",
        "panel": "#161624",
        "panel-2": "#1d1d2e",
        "border": "#2a2a40",
        "text": "#ececf4",
        "muted": "#9a9ab3",
        "faint": "#6b6b85",
        "accent": "#8b5cf6",
        "accent-2": "#ec4899",
        "on-accent": "#fff"
      },
      "shadow": "0 10px 30px rgba(0, 0, 0, .35)"
    },
    {
      "id": "oled",
      "name": "OLED black",
      "css_selector": ":root[data-theme=\"oled\"]",
      "note": "true black: pixels switch off on OLED screens",
      "dark": true,
      "colors": {
        "bg": "#000",
        "bg-2": "#000",
        "panel": "#0b0b0d",
        "panel-2": "#17171b",
        "border": "#232329",
        "text": "#ececf4",
        "muted": "#9a9aa8",
        "faint": "#66666f",
        "accent": "#f0ead6",
        "accent-2": "#d6c49a",
        "on-accent": "#16161f"
      },
      "shadow": "none"
    },
    {
      "id": "light",
      "name": "Light",
      "css_selector": ":root[data-theme=\"light\"]",
      "note": null,
      "dark": false,
      "colors": {
        "bg": "#f6f6fb",
        "bg-2": "#ffffff",
        "panel": "#ffffff",
        "panel-2": "#f0f0f7",
        "border": "#e2e2ee",
        "text": "#16161f",
        "muted": "#5d5d75",
        "faint": "#8d8da5",
        "accent": "#2a2a2d",
        "accent-2": "#8a7a4e",
        "on-accent": "#f0ead6"
      },
      "shadow": "0 10px 30px rgba(20, 20, 50, .08)"
    }
  ],
  "on_accent": {
    "$comment": "appearance.rs apply: dark text on light accents (mean relative luminance of the two colours above the threshold), white on dark ones",
    "threshold": 0.45,
    "dark": "#16161f",
    "light": "#fff"
  },
